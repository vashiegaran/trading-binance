# Binance API Credentials
# Get these from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Trading Configuration
TRADING_PAIR=SOLUSDT
TRADE_AMOUNT_USDT=100
MIN_CONFIDENCE=50
USE_MARKET_ORDERS=true

# Risk Management (Optimized for existing $20 SOL position)
MAX_POSITION_VALUE_USDT=22        # Maximum total value in SOL position (handles $20 position + price fluctuations)
STOP_LOSS_PERCENT=5               # Stop loss: sell if position is down X% from entry (default: 5%)
MAX_DRAWDOWN_PERCENT=10           # Maximum drawdown: pause trading if portfolio is down X% from startup (default: 10%)
TAKE_PROFIT_PERCENT=20            # Take profit: sell if position is up X% from entry (default: 20%)
EMERGENCY_STOP_LOSS_PERCENT=15    # Emergency stop-loss: sell ALL if portfolio is down X% from startup (works even without trades, default: 15%)
MIN_TRADE_AMOUNT_USDT=5           # Minimum trade amount (lowered from $10 to better utilize $20 wallet)

# MongoDB Configuration (for analytics dashboard)
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/trading_bot
# OR MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/trading_bot

MONGODB_DB_NAME=trading_bot

# Logging
LOG_LEVEL=info

# Trading Mode (paper trading for testing)
PAPER_TRADING=false

